# JWT signing key: Base64 encoding of at least 32 random bytes.
Jwt__Issuer=EventGO
Jwt__Audience=EventGO.Client
Jwt__SecretKey=
Jwt__AccessTokenMinutes=15

# SMTP password-reset delivery. Do not commit real credentials.
PasswordResetEmail__Host=
PasswordResetEmail__Port=587
PasswordResetEmail__EnableSsl=true
PasswordResetEmail__UserName=
PasswordResetEmail__Password=
PasswordResetEmail__FromAddress=
PasswordResetEmail__FromName=EventGO
PasswordResetEmail__ResetUrl=
